%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d44457e90aa1d4b468691a1f3ed3df41, type: 3}
  m_Name: BlameTextConfig
  m_EditorClassIdentifier: FB.Game::FB.Game.Blame.BlameTextConfig
  _templates:
  - _event: 0
    _filter: 0
    _text: "{A} \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0430, \u0449\u043E \u0441\u044C\u043E\u0433\u043E\u0434\u043D\u0456
      \u0457\u0457 \u0434\u0435\u043D\u044C. \xAB{I}\xBB \u043F\u0430\u043B\u0430\u0454."
  - _event: 0
    _filter: 0
    _text: "{A}: \xAB\u042F \u043B\u0438\u0448\u0435 \u0442\u0440\u043E\u0445\u0438
      \u0456\u0441\u043A\u0440\u044E\xBB. \xAB{I}\xBB \u0433\u043E\u0440\u0438\u0442\u044C."
  - _event: 1
    _filter: 0
    _text: "\u0412\u0456\u0434 \xAB{S}\xBB \u0432\u043E\u0433\u043E\u043D\u044C \u043F\u0435\u0440\u0435\u0441\u043A\u043E\u0447\u0438\u0432
      \u043D\u0430 \xAB{I}\xBB. \u0429\u0435\u0434\u0440\u043E."
  - _event: 1
    _filter: 0
    _text: "\u0427\u0435\u0440\u0433\u0430 \u043F\u043E\u0433\u0440\u0456\u0442\u0438\u0441\u044C:
      \xAB{I}\xBB."
  - _event: 1
    _filter: 0
    _text: "\u0412\u043E\u0433\u043E\u043D\u044C \u043F\u0435\u0440\u0435\u0431\u0440\u0430\u0432\u0441\u044F
      \u043D\u0430 \xAB{I}\xBB. \u0411\u0435\u0437 \u0437\u0430\u043F\u0440\u043E\u0448\u0435\u043D\u043D\u044F."
  - _event: 1
    _filter: 0
    _text: "\u0422\u0435\u043F\u0435\u0440 \u0433\u043E\u0440\u0438\u0442\u044C \u0449\u0435
      \u0439 \xAB{I}\xBB. \xAB{S}\xBB \u043F\u0435\u0440\u0435\u0434\u0430\u0454
      \u043F\u0440\u0438\u0432\u0456\u0442."
  - _event: 2
    _filter: 0
    _text: "\u0417\u0433\u043E\u0440\u0456\u043B\u043E \u0434\u043E\u0442\u043B\u0430:
      \xAB{I}\xBB. \u0413\u043E\u043B\u043E\u0432\u043D\u0438\u0439 \u043F\u0456\u0434\u043E\u0437\u0440\u044E\u0432\u0430\u043D\u0438\u0439:
      {A}."
  - _event: 2
    _filter: 0
    _text: "\u0412\u0456\u0434 \xAB{I}\xBB \u043B\u0438\u0448\u0438\u043B\u0438\u0441\u044C
      \u0441\u043F\u043E\u0433\u0430\u0434\u0438 \u0456 \u0432\u0443\u0433\u0456\u043B\u043B\u044F."
  - _event: 2
    _filter: 0
    _text: "\xAB{I}\xBB: \u0431\u0443\u043B\u043E \u0433\u0430\u0440\u043D\u043E,
      \u0441\u0442\u0430\u043B\u043E \u0445\u0440\u0443\u0441\u0442\u043A\u043E."
  - _event: 2
    _filter: 1
    _text: "\u041F\u043E\u043A\u0438 \u0442\u0438 \u0448\u0443\u043A\u0430\u0432,
      \u043A\u0443\u0434\u0438 \u043D\u0430\u0442\u0438\u0441\u043D\u0443\u0442\u0438,
      \u0432\u0456\u0434 \xAB{I}\xBB \u043B\u0438\u0448\u0438\u0432\u0441\u044F \u043F\u043E\u043F\u0456\u043B."
  - _event: 3
    _filter: 1
    _text: "\u0422\u0438 \u043F\u043E\u043B\u0438\u0432 \xAB{I}\xBB. \u0421\u0442\u0440\u0443\u043C
      \u043E\u0446\u0456\u043D\u0438\u0432."
  - _event: 3
    _filter: 1
    _text: "\u0412\u043E\u0434\u043D\u0456 \u043F\u0440\u043E\u0446\u0435\u0434\u0443\u0440\u0438
      \u0434\u043B\u044F \xAB{I}\xBB. \u041F\u043E\u0441\u043C\u0435\u0440\u0442\u043D\u0456."
  - _event: 3
    _filter: 1
    _text: "\u0422\u0438 \u043F\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0432:
      \xAB{I}\xBB \u0456 \u0432\u043E\u0434\u0430 \u043D\u0435 \u0434\u0440\u0443\u0436\u0430\u0442\u044C."
  - _event: 3
    _filter: 2
    _text: "\u041D\u0430\u043F\u0440\u0443\u0433\u0438 \u043D\u0435 \u0432\u0438\u0442\u0440\u0438\u043C\u0430\u043B\u043E:
      \xAB{I}\xBB. \u042F\u043A \u0456 \u0432\u0441\u0456 \u043C\u0438."
  - _event: 4
    _filter: 1
    _text: "\u041F\u043E\u0436\u0435\u0436\u0443 \xAB{I}\xBB \u043F\u0435\u0440\u0435\u0436\u0438\u0432.
      \u0422\u0435\u0431\u0435 \u2014 \u043D\u0456."
  - _event: 4
    _filter: 1
    _text: "\u0422\u0438 \u043F\u043E\u043B\u0438\u0432 \xAB{I}\xBB. \u0422\u0440\u043E\u0445\u0438
      \u0437\u0430\u0431\u0430\u0433\u0430\u0442\u043E. \u041B\u0456\u0442\u0440\u0456\u0432
      \u043D\u0430 \u0442\u0440\u0438\u0441\u0442\u0430."
  - _event: 4
    _filter: 0
    _text: "\xAB{I}\xBB \u0443\u0442\u043E\u043F\u043B\u0435\u043D\u043E \u0437 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E\u044E
      \u0441\u0442\u0430\u0440\u0430\u043D\u043D\u0456\u0441\u0442\u044E."
  - _event: 5
    _filter: 2
    _text: "\u0422\u0435\u0431\u0435 \u0432\u0434\u0430\u0440\u0438\u043B\u043E \u0441\u0442\u0440\u0443\u043C\u043E\u043C.
      \u041F\u043E\u0434\u044F\u043A\u0430: {A}."
  - _event: 5
    _filter: 0
    _text: "\u041A\u0430\u043B\u044E\u0436\u0430 + \u0440\u043E\u0437\u0435\u0442\u043A\u0430
      = \u0442\u0438 \u0442\u0430\u043D\u0446\u044E\u0454\u0448."
  - _event: 5
    _filter: 0
    _text: "\u0421\u0442\u0440\u0443\u043C \u043E\u0446\u0456\u043D\u0438\u0432 \u0442\u0432\u043E\u0457
      \u043C\u043E\u043A\u0440\u0456 \u0447\u0435\u0440\u0435\u0432\u0438\u043A\u0438."
  - _event: 5
    _filter: 0
    _text: "\u041C\u043E\u043A\u0440\u0430 \u043F\u0456\u0434\u043B\u043E\u0433\u0430,
      \u0436\u0438\u0432\u0438\u0439 \u043F\u043E\u0434\u043E\u0432\u0436\u0443\u0432\u0430\u0447,
      \u0449\u0430\u0441\u043B\u0438\u0432\u0438\u0439 \u0442\u0438."
  - _event: 5
    _filter: 1
    _text: "\u0422\u0438 \u043D\u0430\u043B\u0438\u0432 \u043A\u0430\u043B\u044E\u0436\u0443
      \u0456 \u0441\u0442\u0430\u0432 \u0443 \u043D\u0435\u0457. \u0413\u0435\u043D\u0456\u0430\u043B\u044C\u043D\u043E."
  - _event: 5
    _filter: 1
    _text: "\u0422\u0438 \u0441\u0430\u043C \u0441\u043E\u0431\u0456 \u0435\u043B\u0435\u043A\u0442\u0440\u0438\u043A.
      \u0406 \u043F\u0430\u0446\u0456\u0454\u043D\u0442."
  - _event: 6
    _filter: 0
    _text: "\u0421\u0442\u0440\u0443\u043C \u043F\u0456\u0434\u043A\u0438\u043D\u0443\u0432
      \xAB{I}\xBB."
  - _event: 6
    _filter: 0
    _text: "\u0417\u0430\u0440\u044F\u0434 \u0431\u0430\u0434\u044C\u043E\u0440\u043E\u0441\u0442\u0456
      \u0434\u043B\u044F \xAB{I}\xBB."
  - _event: 6
    _filter: 0
    _text: "\xAB{I}\xBB \u0442\u0430\u043D\u0446\u044E\u0454. \u041C\u0443\u0437\u0438\u043A\u0438
      \u043D\u0435\u043C\u0430\u0454, \u0441\u0442\u0440\u0443\u043C \u0454."
